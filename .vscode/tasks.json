{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "platform",
            "type": "pickString",
            "description": "¿Compilar para qué plataforma?",
            "options": ["linux", "windows", "windows-run"],
            "default": "linux"
        }
    ],
    "tasks": [
        {
            "label": "Build ProyecThor",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/build.sh",
            "args": ["${input:platform}"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Run ProyecThor (Wine)",
            "type": "shell",
            "command": "wine",
            "args": ["ProyecThor.exe"],
            "options": {
                "cwd": "${workspaceFolder}/build-win"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}